# Configuración de Base de Datos
# Reemplaza estos valores con los de tu hosting MySQL
DATABASE_URL=jdbc:mysql://localhost:3306/web_mdnch_db?useSSL=false&serverTimezone=America/Lima&allowPublicKeyRetrieval=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=root

# Configuración JWT
# IMPORTANTE: Genera un nuevo secret fuerte para producción
# Puedes generarlo con: [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 } ))
JWT_SECRET=OYDDIeIjzB7ifqcxzfri/11CwOTk6eQwhpElw88mKPWfV84gWjw/lqzFgqPbPAn7d3gjIoVQFGA67pHGqzr4JQ==
JWT_EXPIRATION_MS=86400000

# Base URL de la aplicación
# Para desarrollo local: http://localhost:8080
# Para producción: https://tu-app.onrender.com
BASE_URL=http://localhost:8080

# Puerto del servidor (Render lo asigna automáticamente)
PORT=8080

# Profile activo de Spring
SPRING_PROFILES_ACTIVE=prod

# Opciones de JVM (ajustar según recursos disponibles)
JAVA_OPTS=-Xmx512m -Xms256m
